# === LLM Provider (escolha um) ===
# groq | ark | openai  (auto-detect se vazio)
LLM_PROVIDER=

# Groq (gratis, Llama 3.3 70B) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Volcengine Ark (Doubao) — https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Database ===
DB_PATH=./data/supply_chain.duckdb
# DATABASE_URL=postgresql://supply:supply@localhost:5432/supply_chain
