# ============================================
# LLM Provider (auto-detect if LLM_PROVIDER empty)
# groq | ark | openai
# ============================================
LLM_PROVIDER=

# --- Groq (free tier) — https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- BytePlus Ark (ap-southeast) ---
# Get key from https://console.byteplus.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=seed-2-0-lite-260428

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Database
# ============================================
DB_PATH=./data/supply_chain.duckdb
# DATABASE_URL=postgresql://supply:supply@localhost:5432/supply_chain
